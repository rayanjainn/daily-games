{
  "name": "everydaily",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:history": "bash scripts/check-history.sh",
    "db:migrate": "pnpm --filter @everydaily/scripts exec tsx db-migrate.ts",
    "db:generate": "pnpm --filter @everydaily/shared db:generate",
    "seed:games": "pnpm --filter @everydaily/scripts exec tsx seed-games.ts",
    "user:role": "pnpm --filter @everydaily/scripts exec tsx set-role.ts",
    "icons:generate": "pnpm --filter @everydaily/scripts exec tsx generate-icons.ts",
    "keys:realtime": "pnpm --filter @everydaily/scripts exec tsx generate-realtime-keys.ts",
    "keys:vapid": "pnpm --filter @everydaily/scripts exec tsx generate-vapid-keys.ts",
    "dev:redis-shim": "pnpm --filter @everydaily/scripts exec tsx dev/upstash-shim.ts",
    "seed:demo": "pnpm --filter @everydaily/scripts exec tsx seed-demo.ts",
    "probe:embeds": "NODE_USE_ENV_PROXY=1 pnpm --filter @everydaily/scripts exec tsx probe-embeds.ts",
    "catalog:summary": "pnpm --filter @everydaily/scripts exec tsx catalog-summary.ts",
    "check:budgets": "tsx scripts/check-budgets.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
