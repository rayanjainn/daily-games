# Copy to .env (web) and apps/worker/.dev.vars (worker). Never commit real values.

# --- Public URLs ---------------------------------------------------------------
APP_URL=http://localhost:3000
REALTIME_URL=ws://localhost:8787

# WebAuthn: RP ID must be the exact app host (no scheme, no port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=EveryDaily
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Database -----------------------------------------------------------------
# Local: scripts/local-services.sh or docker compose. Production: Neon pooled URL.
DATABASE_URL=postgres://everydaily:everydaily@localhost:5432/everydaily

# --- Upstash Redis (REST) -----------------------------------------------------
# Local: docker compose exposes an Upstash-compatible shim on :8079.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token
