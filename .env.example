# Copy to .env (web) and apps/worker/.dev.vars (worker). Never commit real values.

# --- Public URLs ---------------------------------------------------------------
APP_URL=http://localhost:3000
REALTIME_URL=ws://localhost:8787

# WebAuthn: RP ID must be the exact app host (no scheme, no port).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=EveryDaily
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Auth ---------------------------------------------------------------------
# 32+ random bytes, e.g. `openssl rand -base64 48`. Signs gate passes and recovery checks.
AUTH_SECRET=
# Proof-of-work difficulty in leading zero bits (16 ≈ 1s on a phone).
POW_DIFFICULTY=16
# Optional Cloudflare Turnstile on sign-up.
FEATURE_TURNSTILE=0
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# "Suggest a game": off | admin (moderators only, the launch default) | all
FEATURE_SUBMISSIONS=admin

# --- Database -----------------------------------------------------------------
# Local: scripts/local-services.sh or docker compose. Production: Neon pooled URL.
DATABASE_URL=postgres://everydaily:everydaily@localhost:5432/everydaily
TEST_DATABASE_URL=postgres://everydaily:everydaily@localhost:5432/everydaily_test

# --- Upstash Redis (REST) -----------------------------------------------------
# Local: docker compose exposes an Upstash-compatible shim on :8079, or run
# `pnpm dev:redis-shim` against a local redis-server.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token

# --- Realtime (generate with: pnpm keys:realtime) ------------------------------
# Web app holds the private signing key; the worker gets only REALTIME_PUBLIC_KEY.
WORKER_INTERNAL_URL=http://localhost:8787
REALTIME_SIGNING_KEY=
INTERNAL_BROADCAST_SECRET=

# --- Web push (generate with: pnpm keys:vapid) ---------------------------------
# Public key is shared with browsers; private key lives only in the worker.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
