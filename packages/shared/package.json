{
  "name": "@everydaily/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./parsers": "./src/parsers/index.ts",
    "./realtime": "./src/realtime/index.ts",
    "./registry": "./src/registry/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx ../../scripts/db-migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11"
  }
}
